configuration {
    font: "JetBrains Mono 12";
    show-icons: true;
    case-sensitive: false;
}

@theme "~/.config/rofi/theme.rasi"

window {
    width:            100%;
    height:           40%; 
    border-radius:    0px;
    border:           2px;
    background-color: #1E1D2E66;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    border:           0px;
    spacing:          0px;
    padding:          0px;
    children:         [ "listview" ];
}

listview {
    columns:          9;
    lines:            1;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          0px;
    padding:          0px;
    margin:           0px;
    background-color: transparent;
    fixed-height:     true;
}

element {
    orientation:      vertical;
    padding:          10px 3px;
    spacing:          10px 0px;
    background-color: transparent;
    text-color:       @foreground;
    margin:           10px;
    border-radius:    20px;
}

element selected {
    background-color: @selected-background;
    border-radius:    20px;
}

element-icon {
    size:             34%;
    horizontal-align: 0.5;
    background-color: transparent;
    cursor:           inherit;
    border-radius:    50px;
}

element-text {
    enabled: true;
    background-color: transparent;
    text-color: @foreground;
    horizontal-align: 0.5;
}

element-text selected{
    text-color:       @selected-foreground;
}

