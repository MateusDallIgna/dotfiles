$HOME/.config/rofi/theme.rasi
* {
    background:          #1E1E2DE8;
    background-alt:      #29283EFF;
    foreground:          #E8D9E8FF;

    selected-background: #D3A5D2FF;
    selected-foreground: #1E1E2DFF;

    border:              #8E91D2FF;

    active:              #AAA0D8FF;
    urgent:              #E1A6CEFF;
}
